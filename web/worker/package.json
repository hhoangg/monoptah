{
  "name": "@monoptah/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monoptah web Worker: Hono API, D1 schema, DesktopRoom Durable Object",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "predev": "node scripts/ensure-assets.mjs",
    "dev": "wrangler dev --port 8787 --local-upstream localhost:8787 -c ../wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply monoptah --local -c ../wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply monoptah --remote -c ../wrangler.jsonc",
    "bootstrap": "node ../scripts/bootstrap.mjs",
    "db:generate": "drizzle-kit generate",
    "pretest": "node scripts/ensure-assets.mjs"
  },
  "dependencies": {
    "@monoptah/protocol": "workspace:*",
    "@simplewebauthn/server": "^14.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@monoptah/mock-desktop": "workspace:*",
    "@cloudflare/vitest-plugin": "1.8.3",
    "@cloudflare/workers-types": "5.20261116.1",
    "drizzle-kit": "^0.31.11",
    "wrangler": "4.163.0"
  }
}
