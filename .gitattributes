# Shell scripts are also embedded in the desktop app and sent to Unix hosts.
*.sh text eol=lf

# Signature verification requires identical package bytes on every platform.
crates/monocode-core/src/app_update/fixtures/package.txt text eol=lf

# Mono workflow fixtures are compared byte for byte with what the TS store and
# YAML export wrote, so a CRLF checkout on Windows must not rewrite them.
crates/monocode-core/src/mono/workflows/fixtures/** text eol=lf
